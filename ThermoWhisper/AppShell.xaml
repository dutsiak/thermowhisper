<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ThermoWhisper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ThermoWhisper"
    xmlns:loc="clr-namespace:ThermoWhisper.Localization"
    xmlns:keys="clr-namespace:ThermoWhisper.Application;assembly=ThermoWhisper.Application"
    Title="{loc:Localize Key={x:Static keys:TextKeys.AppTitle}}">

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
