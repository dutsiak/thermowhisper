#!/bin/sh
# Searches for secrets before a commit (section 17).
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --no-banner >/dev/null 2>&1; then
    echo "pre-commit: a possible secret was found. Details: gitleaks git --pre-commit --staged -v (section 17)" >&2; exit 1
  fi
else
  echo "pre-commit: gitleaks is not installed - the secret check was skipped (section 17)" >&2
fi
